# =====================================================================
# 7Summits OS — Environment Variables
# =====================================================================
# Copy this file to .env.local for local development.
# For production, set these in Vercel Project Settings → Environment Variables.

# --- Supabase ---
# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://nqxdxiejnxfffwztkrpd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your_anon_key>

# Server-only (NEVER expose to browser — used only in Server Actions, API routes, server-side admin ops)
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://corporate.7summitstravel.com
